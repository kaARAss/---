# Server mode only. GitHub Pages uses a personal repository-scoped token in the admin UI.
TAIS_ADMIN_USERNAME=admin
# Set a unique password of at least 12 characters before starting the server.
TAIS_ADMIN_PASSWORD=
# Credentials/config MUST be outside the public repository directory.
# TAIS_CONFIG_FILE=/var/lib/tais/admin-config.json
# Optional server-side publication; never put the real token into a Git commit.
TAIS_GITHUB_TOKEN=
TAIS_GITHUB_OWNER=kaARAss
TAIS_GITHUB_REPO=---
TAIS_GITHUB_BRANCH=main
PORT=3000
# Enable only when running behind your own trusted reverse proxy:
# TAIS_TRUST_PROXY=1
